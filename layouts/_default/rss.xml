{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ .Site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description | default "Recent content" }}</description>
    <generator>Hugo</generator>
    <language>{{ .Site.LanguageCode }}</language>
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ with .OutputFormats.Get "RSS" }}{{ .Permalink }}{{ else }}{{ .Permalink }}{{ end }}" rel="self" type="application/rss+xml" />

    {{- $pages := .RegularPages -}}
    {{- if .IsHome -}}
      {{- $pages = .Site.RegularPages -}}
    {{- end -}}
    {{- $pages = where $pages "Section" "ne" "pages" -}}
    {{- range $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>

      {{/* 纯文本摘要：优先 frontmatter abstract；否则用正文纯文本截断（用于 Telegram/Telegraph 分发） */}}
      {{- $excerpt := .Params.abstract | default "" -}}
      {{- if not $excerpt -}}
        {{- $excerpt = .Plain -}}
      {{- end -}}
      {{- $maxDesc := int (default 1200 .Site.Params.rssDescriptionMaxChars) -}}
      {{- if gt $maxDesc 0 -}}
        {{- $excerpt = $excerpt | plainify | truncate $maxDesc -}}
      {{- else -}}
        {{- $excerpt = $excerpt | plainify -}}
      {{- end -}}
      <description>{{ $excerpt }}</description>

      {{/* Markdown 正文：优先使用 .RawContent（原始 Markdown，不含 shortcode 渲染）。若为空则回退从源文件读取并剥离 frontmatter。 */}}
      {{- $markdown := .RawContent -}}
      {{- if not $markdown -}}
        {{- with .File -}}
          {{- $src := readFile .Filename -}}
          {{- $markdown = replaceRE "(?s)^---\\s*\\r?\\n.*?\\r?\\n---\\s*\\r?\\n" "" $src -}}
          {{- $markdown = replaceRE "(?s)^\\+\\+\\+\\s*\\r?\\n.*?\\r?\\n\\+\\+\\+\\s*\\r?\\n" "" $markdown -}}
        {{- end -}}
      {{- end -}}
      {{- $maxChars := int (default 4000 .Site.Params.rssContentMaxChars) -}}
      {{- if gt $maxChars 0 -}}
        {{- if gt (len $markdown) $maxChars -}}
          {{- $markdown = slicestr $markdown 0 $maxChars -}}
        {{- end -}}
      {{- end -}}
      {{- $markdown = replace $markdown "]]>" "]]&gt;" -}}
      <content:encoded>{{ printf "<![CDATA[%s]]>" $markdown | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
